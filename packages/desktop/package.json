{
  "name": "@podlist/desktop",
  "productName": "PodList",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node scripts/build-mcp.ts && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test:app": "node scripts/build-mcp.ts && playwright test",
    "build:mcp": "node scripts/build-mcp.ts",
    "build:app": "node scripts/build-app.ts",
    "install:app": "node scripts/build-app.ts --install"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.65.0",
    "electron": "44.9.3",
    "playwright": "1.65.0",
    "sharp": "0.35.5"
  }
}
