{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podlist.local/protocol/v4/operation.schema.json",
  "$comment": "PodList sync protocol v4. Generated from packages/domain/src/Operation.ts; do not edit.",
  "$ref": "#/$defs/@podlist~1domain~1OperationEncoded",
  "$defs": {
    "@podlist/domain/ViewEncoded": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "filter": {
          "type": "object",
          "properties": {
            "published": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "_tag": {
                      "type": "string",
                      "enum": ["LastDays"]
                    },
                    "days": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["_tag", "days"],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "_tag": {
                      "type": "string",
                      "enum": ["Between"]
                    },
                    "from": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "to": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["_tag", "from", "to"],
                  "additionalProperties": true
                }
              ]
            },
            "podcasts": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["include", "exclude"]
                },
                "subscriptionIds": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ],
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["mode", "subscriptionIds"],
              "additionalProperties": true
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "played": {
              "type": "string",
              "enum": ["unplayed", "inProgress", "played"]
            },
            "starred": {
              "type": "boolean"
            },
            "notInAnyPlaylist": {
              "type": "boolean",
              "enum": [true]
            },
            "minDuration": {
              "type": "number",
              "minimum": 0
            },
            "maxDuration": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "sort": {
          "type": "string",
          "enum": ["publishedDesc", "publishedAsc", "durationAsc", "durationDesc"]
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "name", "filter", "sort", "limit"],
      "additionalProperties": true
    },
    "@podlist/domain/DownloadRuleEncoded": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["never", "onEntry", "allNew"]
        },
        "keepAtMost": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["subscriptionId", "deviceId", "mode", "keepAtMost"],
      "additionalProperties": true
    },
    "@podlist/domain/PlaybackSettingsEncoded": {
      "type": "object",
      "properties": {
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "skipIntro": {
          "type": "number",
          "minimum": 0
        },
        "skipOutro": {
          "type": "number",
          "minimum": 0
        },
        "volumeBoost": {
          "type": "boolean"
        }
      },
      "required": ["speed", "skipIntro", "skipOutro", "volumeBoost"],
      "additionalProperties": true
    },
    "@podlist/domain/OperationEncoded": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recordedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "change": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["AddEntry"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "placement": {
                  "type": "string",
                  "enum": ["now", "next", "last"]
                }
              },
              "required": ["_tag", "playlistId", "episodeId", "placement"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["MoveEntry"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["_tag", "playlistId", "episodeId", "after"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["RemoveEntry"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "playlistId", "episodeId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetCursor"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "episodeId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["_tag", "playlistId", "episodeId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["ReportPosition"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "number",
                  "minimum": 0
                },
                "listenedAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "listening": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "day": {
                        "type": "string"
                      },
                      "subscriptionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "seconds": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": ["day", "subscriptionId", "seconds"],
                    "additionalProperties": true
                  }
                }
              },
              "required": ["_tag", "playlistId", "episodeId", "position", "listenedAt"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["RecordListening"]
                },
                "amounts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "day": {
                        "type": "string"
                      },
                      "subscriptionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "seconds": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": ["day", "subscriptionId", "seconds"],
                    "additionalProperties": true
                  }
                }
              },
              "required": ["_tag", "amounts"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["MarkPlayed"]
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "_tag": {
                          "type": "string",
                          "enum": ["Playback"]
                        },
                        "playlistId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["_tag", "playlistId"],
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "properties": {
                        "_tag": {
                          "type": "string",
                          "enum": ["User"]
                        }
                      },
                      "required": ["_tag"],
                      "additionalProperties": true
                    }
                  ]
                }
              },
              "required": ["_tag", "episodeId", "source"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["MarkUnplayed"]
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "episodeId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["MarkSubscriptionPlayed"]
                },
                "subscriptionId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "subscriptionId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetStar"]
                },
                "episodeId": {
                  "type": "string",
                  "minLength": 1
                },
                "starred": {
                  "type": "boolean"
                }
              },
              "required": ["_tag", "episodeId", "starred"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["CreatePlaylist"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "clearOnPlayed": {
                  "type": "boolean"
                }
              },
              "required": ["_tag", "playlistId", "name", "clearOnPlayed"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["RenamePlaylist"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "playlistId", "name"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetClearOnPlayed"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "clearOnPlayed": {
                  "type": "boolean"
                }
              },
              "required": ["_tag", "playlistId", "clearOnPlayed"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["DeletePlaylist"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "playlistId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["RestorePlaylist"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "playlistId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetTrashDays"]
                },
                "days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": ["_tag", "days"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetActivePlaylist"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "playlistId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["Rewind"]
                },
                "playlistId": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["_tag", "playlistId", "to"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SaveView"]
                },
                "view": {
                  "$ref": "#/$defs/@podlist~1domain~1ViewEncoded"
                }
              },
              "required": ["_tag", "view"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["DeleteView"]
                },
                "viewId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["_tag", "viewId"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetDownloadRule"]
                },
                "rule": {
                  "$ref": "#/$defs/@podlist~1domain~1DownloadRuleEncoded"
                }
              },
              "required": ["_tag", "rule"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetPlaybackSettings"]
                },
                "settings": {
                  "$ref": "#/$defs/@podlist~1domain~1PlaybackSettingsEncoded"
                }
              },
              "required": ["_tag", "settings"],
              "additionalProperties": true
            },
            {
              "type": "object",
              "properties": {
                "_tag": {
                  "type": "string",
                  "enum": ["SetSubscriptionOverrides"]
                },
                "subscriptionId": {
                  "type": "string",
                  "minLength": 1
                },
                "playbackSettings": {
                  "type": "object",
                  "properties": {
                    "speed": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 3
                    },
                    "skipIntro": {
                      "type": "number",
                      "minimum": 0
                    },
                    "skipOutro": {
                      "type": "number",
                      "minimum": 0
                    },
                    "volumeBoost": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                },
                "playedThreshold": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["_tag", "subscriptionId", "playbackSettings", "playedThreshold"],
              "additionalProperties": true
            }
          ]
        }
      },
      "required": ["id", "deviceId", "sequence", "recordedAt", "change"],
      "additionalProperties": true
    }
  }
}
