{
  "name": "podlist",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "pnpm --filter @podlist/web dev",
    "dev:server": "pnpm --filter @podlist/server dev",
    "desktop:install": "git pull --ff-only && pnpm install --frozen-lockfile && pnpm --filter @podlist/desktop install:app",
    "check:android": "cd apps/android && ./gradlew :domain:test :data:test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@effect/vitest": "4.1.2",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
